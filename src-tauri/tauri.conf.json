{
  "productName": "Slipstream",
  "version": "0.1.3",
  "identifier": "app.slipstream.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Slipstream",
        "width": 380,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "resources/EULA.txt",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": ["engine/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["Turkish", "English"]
      }
    }
  }
}
