{
  "productName": "Slipstream",
  "version": "0.5.1",
  "identifier": "app.slipstream.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Slipstream",
        "width": 380,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https: ipc: http://ipc.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "licenseFile": "resources/EULA.txt",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "engine/*"
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installMode": "currentUser",
        "startMenuFolder": "Slipstream",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "Turkish": "resources/Turkish.nsh"
        }
      }
    }
  }
}
